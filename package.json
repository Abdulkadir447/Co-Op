{
  "name": "coop",
  "version": "1.0.0",
  "private": true,
  "description": "Co-op - AI-powered Business Management Platform",
  "scripts": {
    "prepare": "husky install",
    "commitlint": "commitlint --edit $1",
    "build": "pnpm --filter ./frontend build",
    "dev": "pnpm --filter ./frontend dev",
    "dist:desktop": "npm --prefix electron run dist",
    "dev:desktop": "npm --prefix electron run build:renderer && npm --prefix electron run start"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
