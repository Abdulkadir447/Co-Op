#!/bin/bash
# .husky/commit-msg — run commitlint on the message.
#
# Husky v9 runs this file directly; the two loader lines that v8 needed
# (`#!/usr/bin/env sh` and sourcing .husky/_/husky.sh) are deprecated and make
# every commit print a warning that they will fail in v10.
npx commitlint --edit "$1"
