{
  "app": {
    "name": "Co-op",
    "tagline": "Your Business, Smarter.",
    "environment": "development",
    "version": "1.0.0",
    "debug": true
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "timeoutMs": 30000
  },
  "database": {
    "driver": "postgresql+asyncpg",
    "host": "localhost",
    "port": 5432,
    "name": "coop"
  },
  "sync": {
    "enabled": false,
    "mode": "background",
    "intervalSeconds": 30
  },
  "ai": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "credits_per_request": 1,
    "free_output_tokens": 500,
    "credits_per_1k_output_tokens": 1,
    "rate_limit": {
      "requests": 10,
      "window_seconds": 60
    }
  },
  "features": {
    "dashboard": true,
    "orders": true,
    "inventory": true,
    "customers": true,
    "aiAssistant": true,
    "reports": true,
    "cloudSync": false
  },
  "ui": {
    "defaultTheme": "light",
    "sidebarCollapsed": false,
    "commandPaletteShortcut": "Ctrl+K"
  },
  "logging": {
    "level": "debug"
  },
  "billing": {
    "plans": {
      "free": {
        "label": "Free",
        "credits_per_month": 25
      },
      "starter": {
        "label": "Starter",
        "credits_per_month": 200
      },
      "professional": {
        "label": "Professional",
        "credits_per_month": 1000
      },
      "enterprise": {
        "label": "Enterprise",
        "credits_per_month": null
      }
    },
    "trial": {
      "_comment": "One free trial per business, opt-in from Billing. No card, nothing charged; the effective plan reverts to the base plan when the window closes.",
      "enabled": true,
      "days": 10
    }
  },
  "licensing": {
    "_comment": "Signed activation keys (PRD Ch7 \u00a77.19). The signing key lives ONLY in LICENSE_SIGNING_KEY and admin tokens in LICENSE_ADMIN_TOKENS \u2014 neither belongs in this file.",
    "enabled": true,
    "default_days": 365
  },
  "notifications": {
    "smtp": {
      "host": "",
      "port": 587,
      "username": "",
      "password": "",
      "from": "Co-op <no-reply@coop.app>",
      "tls": true
    }
  },
  "rate_limits": {
    "_comment": "Per-tenant limits for the expensive non-AI endpoints. requests <= 0 disables a section.",
    "imports": {
      "requests": 20,
      "window_seconds": 300
    },
    "exports": {
      "requests": 30,
      "window_seconds": 60
    }
  }
}
