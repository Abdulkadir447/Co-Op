{
  "app": {
    "name": "Co-op",
    "tagline": "Your Business, Smarter.",
    "environment": "testing",
    "version": "1.0.0",
    "debug": true
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "timeoutMs": 10000
  },
  "database": {
    "driver": "sqlite+aiosqlite",
    "name": "coop_test.db"
  },
  "sync": {
    "enabled": false,
    "mode": "disabled",
    "intervalSeconds": 0
  },
  "ai": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "credits_per_request": 1,
    "free_output_tokens": 500,
    "credits_per_1k_output_tokens": 1,
    "rate_limit": {
      "requests": 0,
      "window_seconds": 60
    }
  },
  "features": {
    "dashboard": true,
    "orders": true,
    "inventory": true,
    "customers": true,
    "aiAssistant": false,
    "reports": true,
    "cloudSync": false
  },
  "ui": {
    "defaultTheme": "light",
    "sidebarCollapsed": false,
    "commandPaletteShortcut": "Ctrl+K"
  },
  "logging": {
    "level": "warning"
  },
  "billing": {
    "plans": {
      "free": {
        "label": "Free",
        "credits_per_month": 25
      },
      "starter": {
        "label": "Starter",
        "credits_per_month": 200
      },
      "professional": {
        "label": "Professional",
        "credits_per_month": 1000
      },
      "enterprise": {
        "label": "Enterprise",
        "credits_per_month": null
      }
    },
    "trial": {
      "_comment": "One free trial per business, opt-in from Billing. No card, nothing charged; the effective plan reverts to the base plan when the window closes.",
      "enabled": true,
      "days": 10
    }
  },
  "licensing": {
    "_comment": "Signed activation keys (PRD Ch7 \u00a77.19). The signing key lives ONLY in LICENSE_SIGNING_KEY and admin tokens in LICENSE_ADMIN_TOKENS \u2014 neither belongs in this file.",
    "enabled": true,
    "default_days": 365
  },
  "notifications": {
    "smtp": {
      "host": "",
      "port": 587,
      "username": "",
      "password": "",
      "from": "Co-op <no-reply@coop.app>",
      "tls": true
    }
  },
  "rate_limits": {
    "_comment": "Per-tenant limits for the expensive non-AI endpoints. requests <= 0 disables a section.",
    "imports": {
      "requests": 0,
      "window_seconds": 300
    },
    "exports": {
      "requests": 0,
      "window_seconds": 60
    }
  },
  "paystack": {
    "_comment": "Payments are off in the test environment; the suite monkeypatches paystack_config() with its own pages and prices.",
    "enabled": false,
    "currency": "USD",
    "api_base": "https://api.paystack.co",
    "timeout_seconds": 15,
    "secret_key_env": "PAYSTACK_SECRET_KEY",
    "public_key_env": "PAYSTACK_PUBLIC_KEY",
    "callback_url": null,
    "allowed_callback_hosts": [],
    "payment_pages": {
      "starter": "https://paystack.shop/pay/cc0he0cghk",
      "professional": "https://paystack.shop/pay/8behy0j95a",
      "enterprise": "https://paystack.shop/pay/17zi09vwev"
    },
    "prices_kobo": {}
  }
}
