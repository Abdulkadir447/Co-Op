{
  "name": "coop-electron",
  "version": "0.1.0",
  "description": "Electron wrapper for the Co-op frontend",
  "main": "main.js",
  "scripts": {
    "start": "npm run electron",
    "electron": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build:renderer": "npm --prefix ../frontend run build && node scripts/copy-renderer.js",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "release": "npm run build:renderer && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "app.coop.desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "Abdulkadir447",
        "repo": "Co-Op"
      }
    ],
    "productName": "Co-op",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "dataLayerApp.js",
      "sync.js",
      "platform.js",
      "security.js",
      "db/**/*",
      "renderer-dist/**/*",
      "coop-icon.png",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "coop-icon.png",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Co-op",
      "uninstallDisplayName": "Co-op",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "author": "Co-op",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
