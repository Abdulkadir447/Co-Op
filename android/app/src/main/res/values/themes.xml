<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Coop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Coop.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/coop_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_coop_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Coop</item>
    </style>
</resources>
