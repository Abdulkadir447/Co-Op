# Vercel builds the marketing site (website/). This file keeps the upload
# small — but it must never delete a file the build actually reads.
#
# THE RULE: `website/` imports the app's design tokens and plan catalog
# directly from `frontend/src/theme/*` and `frontend/src/billing/plans.ts`.
# Excluding `frontend/` therefore breaks the build with
# `TS2307: Cannot find module '../../frontend/src/theme/typography'`, which is
# exactly what happened on the first attempt. Those paths are source text and
# cost a few hundred KB; leaving them in is cheaper than a duplicate copy of
# the palette that can drift from the product.
#
# If you add an import from outside `website/`, add its directory here or the
# deploy will fail. `frontend/src` is deliberately NOT ignored.

# Dependency trees and build output — regenerated by the build, never uploaded.
node_modules/
**/node_modules/
.pnpm-store/
frontend/dist/
website/dist/
electron/dist/
electron/out/
release/
*.tsbuildinfo

# Not part of this deployment: the desktop shell and the Python API.
# (`backend/` is 30k lines of Python that none of this build touches.)
electron/
backend/
supabase/
.github/
frontend/Dockerfile
frontend/nginx.conf
frontend/test/
frontend/test-build/

# Environments, keys and local databases: never upload a secret.
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
.venv/
venv/

# Docs, vendored skills and agent definitions: not needed to render a page.
# (`docs/` includes the security review and business plan; no reason to ship.)
.claude/
.agents/
docs/
