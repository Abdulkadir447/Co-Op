# Co-op environment — copy to `.env` (at the REPO ROOT) and fill in.
# Never commit real values.
#
# This is the ONE source of truth for both the backend (which loads it via
# backend/config.py) and the frontend (Vite reads the same root file because
# frontend/vite.config.ts sets envDir: '..'). Do NOT create a separate
# frontend/.env or backend/.env — a second file would drift from this one.

# --- Frontend (Vite) -------------------------------------------------------
# Clerk publishable key (frontend-only). Required at build/dev time.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: override the API base URL (defaults to same-origin /api).
# VITE_API_URL=http://localhost:8000

# --- Backend ---------------------------------------------------------------
# REQUIRED in production and development: Supabase/Postgres connection string.
# SQLite is used only when COOP_ENV=testing.
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/coop

# REQUIRED in production: Clerk Frontend API host (token issuer/JWKS).
# The dev default (bursting-swan-43.clerk.accounts.dev) is refused in prod.
CLERK_FRONTEND_API=your-instance.clerk.accounts.dev

# Comma-separated azp (origin) allow-list for Clerk session tokens.
CLERK_ALLOWED_ORIGINS=https://app.coop.example

# Comma-separated CORS allow-list. Development/testing default to "*".
# PRODUCTION refuses to start with an open CORS policy: set this or the
# cors.origins entry in config/production.json (fail-fast at startup).
CORS_ORIGINS=https://app.coop.example

# Environment: development | testing | production
COOP_ENV=development

# --- Tests ------------------------------------------------------------------
# Optional Postgres URL: enables the true-concurrency stock test.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/coop_test

# --- AI (Ask Zeno real assistant) ------------------------------------------
# Optional but enables the real LLM path. Without it, Ask Zeno gracefully
# falls back to the deterministic verified engine (AI never blocks core ops).
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
# Per-user rate limit on /ai/chat lives in config/<env>.json
# (ai.rate_limit {requests, window_seconds}); requests <= 0 disables it.

# ---- Daily summary email delivery (SMTP; secrets never live in config/*.json) ----
# Leave SMTP_HOST empty to keep the channel off (endpoint answers 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Co-op <no-reply@coop.app>
SMTP_TLS=true

# ---- Email via Resend (preferred over SMTP when RESEND_API_KEY is set) ----
# Get a key at https://resend.com/api-keys and paste it here (never commit it).
RESEND_API_KEY=
# Sender address. onboarding@resend.dev only delivers to your own Resend account
# email (for testing); use an address on a domain you verified in Resend for real sends.
RESEND_FROM=CO OP <onboarding@resend.dev>
# Base URL of the web app, used in email links (e.g. team invites).
APP_BASE_URL=http://localhost:3000
# Inbox that receives in-app product feedback (the periodic prompt). Uses the
# same Resend/SMTP channel above. Leave empty to store feedback without emailing.
FEEDBACK_INBOX=

# ---- Platform console (in-app product-owner admin) ------------------------
# Comma-separated emails allowed to open the in-app Admin console (the /admin
# page and /platform/* API). Case-insensitive. Overrides platform.admin_emails
# in config. Empty => the console is closed to everyone.
COOP_PLATFORM_ADMINS=
# Dev-only: pair with COOP_TEST_AUTH_USER to sign in as a fixed user WITHOUT
# Clerk, and give that user an email so email-gated features (the admin
# console) are reachable locally. Ignored in production.
COOP_TEST_AUTH_EMAIL=

# ---- Licensing (PRD Ch7 §7.19: signed activation keys) ---------------------
# REQUIRED to issue or verify licences. HMAC-SHA256 key: hex or any long
# random string (generate one with: python -c "import secrets;print(secrets.token_hex(32))").
# Without it /admin/generate-license and /licenses/activate answer 503.
LICENSE_SIGNING_KEY=
# Comma-separated secrets for the team-only /admin/* licence routes, sent as
# the X-Admin-Token header. Empty => those routes are closed, never open.
LICENSE_ADMIN_TOKENS=

# --- Payments (Paystack) ----------------------------------------------------
# SECRET — never commit a real value. Test keys start with sk_test_, live keys
# with sk_live_. Get it from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# Optional: only needed if the inline Paystack JS popup is ever used.
# PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# Which plan opens which hosted payment page, and what Co-op charges, live in
# config/<env>.json under "paystack" — not here (they are not secrets).
# With PAYSTACK_SECRET_KEY set, the backend can verify a charge itself and
# accept signed webhooks; without it, checkout still redirects to the hosted
# page but upgrades wait for the webhook. Point Paystack's webhook URL at
# POST /webhooks/paystack.

# --- Security alerting (optional) ------------------------------------------
# If set, security-relevant events (rejected admin token, bad webhook
# signature, ...) are POSTed here as JSON, in addition to the coop.security
# log. Point it at Slack/Discord/a monitor. Leave unset for log-only.
# SECURITY_ALERT_WEBHOOK=https://hooks.example/xxxx
